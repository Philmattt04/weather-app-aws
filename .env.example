# ── AWS Backend ───────────────────────────────────────────────────────────────
# Get this after running: terraform -chdir=terraform output api_gateway_base_url
API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# ── Weather APIs ──────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_key_here

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Terraform variables (terraform.tfvars, not .env.local) ───────────────────
# openweather_api_key = "..."
# youtube_api_key     = "..."
